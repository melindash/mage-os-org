---
import { Icon } from 'astro-icon/components';
import { OPEN_COLLECTIVE_URL } from '~/utils/ideasBoard';
---

<section class="py-16 px-4 sm:px-6 lg:px-8" aria-label="Support Mage-OS">
  <div
    class="max-w-4xl mx-auto rounded-xl border border-orange-200 dark:border-orange-800/50 bg-orange-50/60 dark:bg-orange-950/20 px-8 py-10 flex flex-col md:flex-row items-center gap-6"
  >
    <div class="flex-1 text-center md:text-left">
      <h2 class="text-2xl font-bold font-heading text-gray-900 dark:text-white mb-2">Support Mage-OS</h2>
      <p class="text-muted">
        Donations through Open Collective fund the Mage-OS Association's general work: infrastructure, releases,
        security and community programmes. A donation does not fund a particular idea, add votes or change priorities.
      </p>
    </div>
    <a
      href={OPEN_COLLECTIVE_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 px-6 py-3 bg-primary hover:bg-secondary text-white rounded-lg font-semibold whitespace-nowrap focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
    >
      <Icon name="tabler:heart-handshake" class="w-5 h-5" aria-hidden="true" />
      Donate on Open Collective
      <span class="sr-only">(opens in a new tab)</span>
    </a>
  </div>
</section>
